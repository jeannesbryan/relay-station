# ==========================================================================
# RELAY STATION: ROOT HARDENING
# ==========================================================================
# Applied to the whole application. This is defence in depth behind the
# application-level checks - it does not replace them, and it only has an
# effect on Apache.

# --------------------------------------------------------------------------
# 1. Never serve database files or editor/backup leftovers
# --------------------------------------------------------------------------
# The SQLite database lives in data/ and its WAL sidecars share the same base
# name. A .sqlite served over HTTP is a complete compromise: it carries
# captain_hash, encrypted_privkey and the Telegram token. Blocking by extension
# here covers the case where a file ends up somewhere other than data/.
<FilesMatch "\.(sqlite|sqlite3|sqlite-wal|sqlite-shm|db|db-wal|db-shm)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --------------------------------------------------------------------------
# 2. Protect dotfiles
# --------------------------------------------------------------------------
# .env, .git, .gitignore and friends. .git in particular exposes the entire
# source history, including any secret ever committed.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --------------------------------------------------------------------------
# 3. Protect the deployment-local directory
# --------------------------------------------------------------------------
# khusus/ holds the installer, the registration API and the migration scripts.
# They are meant to be run by the operator, not reached over the web.
#
# This deliberately does NOT deny the whole directory: khusus/index.html is the
# public landing page and must stay reachable. Blocking the directory outright
# would have served a 403 for the project's own front door. Only the executable
# and data files are denied.
#
# These files also carry their own guards now (the installer refuses to run
# twice; node removal needs an admin token), so this rule is defence in depth
# rather than the only thing standing in the way.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^khusus/data/ - [F,L]
    RewriteRule ^khusus/.*\.(php|sql|sqlite|sqlite-wal|sqlite-shm|zip|log|bak)$ - [F,L]
</IfModule>

# --------------------------------------------------------------------------
# 4. Directory listings off
# --------------------------------------------------------------------------
# Without this, a request for /data/ or /media/ with no index file returns a
# browsable listing of every file in it.
Options -Indexes

# --------------------------------------------------------------------------
# 5. No directory execution, and turn off PHP error display
# --------------------------------------------------------------------------
# Errors must not be rendered into responses: they leak paths and SQL. They
# still reach the server log.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# --------------------------------------------------------------------------
# 6. Baseline response headers
# --------------------------------------------------------------------------
# HSTS is deliberately not set here. It is a long-lived commitment for the
# whole domain and should be enabled once you are certain every subdomain is
# HTTPS-capable; a mistake locks users out. Add it deliberately:
#     Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</IfModule>
